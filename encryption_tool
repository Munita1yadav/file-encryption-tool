import tkinter as tk
from tkinter import filedialog, messagebox
from cryptography.fernet import Fernet

# Key generate
def generate_key():
    key = Fernet.generate_key()
    with open("secret.key", "wb") as f:
        f.write(key)
    messagebox.showinfo("Success", "Key Generated Successfully!")

# Load key
def load_key():
    return open("secret.key", "rb").read()

# Encrypt file
def encrypt_file():
    try:
        file_path = filedialog.askopenfilename()
        key = load_key()
        f = Fernet(key)

        with open(file_path, "rb") as file:
            data = file.read()

        encrypted = f.encrypt(data)

        with open(file_path, "wb") as file:
            file.write(encrypted)

        messagebox.showinfo("Success", "File Encrypted Successfully!")

    except:
        messagebox.showerror("Error", "Encryption Failed!")

# Decrypt file
def decrypt_file():
    try:
        file_path = filedialog.askopenfilename()
        key = load_key()
        f = Fernet(key)

        with open(file_path, "rb") as file:
            data = file.read()

        decrypted = f.decrypt(data)

        with open(file_path, "wb") as file:
            file.write(decrypted)

        messagebox.showinfo("Success", "File Decrypted Successfully!")

    except:
        messagebox.showerror("Error", "Decryption Failed!")

# GUI window
root = tk.Tk()
root.title("🔐 File Encryption Tool")
root.geometry("400x300")
root.config(bg="#1e1e2f")

# Title
title = tk.Label(root, text="File Encryption & Decryption", 
                 font=("Arial", 14, "bold"), bg="#1e1e2f", fg="white")
title.pack(pady=20)

# Buttons
btn1 = tk.Button(root, text="Generate Key", command=generate_key,
                 bg="#4CAF50", fg="white", width=20, height=2)
btn1.pack(pady=10)

btn2 = tk.Button(root, text="Encrypt File", command=encrypt_file,
                 bg="#2196F3", fg="white", width=20, height=2)
btn2.pack(pady=10)

btn3 = tk.Button(root, text="Decrypt File", command=decrypt_file,
                 bg="#f44336", fg="white", width=20, height=2)
btn3.pack(pady=10)

# Run app
root.mainloop()
